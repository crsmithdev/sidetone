#!/bin/bash
# Run a long job detached from the agent, and say by voice when it ends.
#
#   scripts/job <name> <command> [args...]
#   scripts/job research claude -p "read the brief and write notes.md"
#
# A subagent dies when Chris interrupts a turn (docs/todo.md, 4a). A process
# in its own session does not. The job writes to ~/.sidetone/jobs/<id>/:
# command.txt, output.log, pid while it runs, and exit when it ends. The
# bridge reads pid and exit to show in the app that a job runs (spec 14.10.4).
# When the job ends, it asks the bridge to say "Job <name> finished." when no
# answer is in progress.
#
# The job runs as a transient systemd user unit, sidetone-job-<id>. A process
# that only calls setsid stays in the cgroup of the unit that started it, and
# a restart of sidetone.service killed such jobs (docs/todo.md, 4b). The unit
# gets the service's own environment file and the caller's PATH, and no other
# variable of the caller.
#
# SIDETONE_SAY_URL points at another bridge, such as a scratch one.
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "usage: scripts/job <name> <command> [args...]" >&2
  exit 2
fi

name=$1
shift
# the name is a directory and goes into JSON, so it is one plain word
if [[ ! $name =~ ^[A-Za-z0-9-]+$ ]]; then
  echo "the name must be letters, digits and hyphens" >&2
  exit 2
fi
id="$(date +%m%d-%H%M%S)-$name"
dir="$HOME/.sidetone/jobs/$id"
say_url=${SIDETONE_SAY_URL:-https://127.0.0.1:3100/say}
mkdir -p "$dir"
printf '%q ' "$@" > "$dir/command.txt"
echo >> "$dir/command.txt"

# shellcheck disable=SC2016
systemd-run --user --collect --quiet --unit="sidetone-job-$id" --same-dir \
  --property=EnvironmentFile=-"$HOME/.sidetone/env" --setenv=PATH="$PATH" \
  bash -c '
  dir=$1 name=$2 say_url=$3
  shift 3
  # the bridge reads this to show that a job runs: the pid, and the dir in this command line
  echo $$ > "$dir/pid"
  status=0
  "$@" > "$dir/output.log" 2>&1 < /dev/null || status=$?
  echo "$status" > "$dir/exit"
  if [ "$status" = 0 ]; then line="Job $name finished."; else line="Job $name failed."; fi
  # -k: the certificate names the tailnet host, not the loopback
  curl -sSk --max-time 10 -X POST -H "content-type: application/json" \
    -d "{\"text\": \"$line\"}" "$say_url" > "$dir/say.log" 2>&1 || true
' job "$dir" "$name" "$say_url" "$@"

echo "$dir"
