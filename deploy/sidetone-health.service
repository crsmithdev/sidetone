# ~/.config/systemd/user/sidetone-health.service
#
# Restart=always answers "is the process there", which is not the question. A
# bridge holding a dropped room, or one whose agent died under it, is a process
# that is there and does nothing. /health answers the real question; this asks.
[Unit]
Description=Ask Sidetone whether it is working
After=sidetone.service
OnFailure=sidetone-recover.service

[Service]
Type=oneshot
EnvironmentFile=%h/.sidetone/env
# --resolve so the tailnet certificate still validates against loopback
ExecStart=/usr/bin/curl -sf --max-time 10 --resolve ${SIDETONE_HEALTH_HOST}:127.0.0.1 ${SIDETONE_HEALTH_URL} -o /dev/null
