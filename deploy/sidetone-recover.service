# ~/.config/systemd/user/sidetone-recover.service
#
# Only restart a bridge that is running and unwell. One that has already given
# up is in failed on purpose, and restarting it from here would paper over the
# start limit and hide the fault that earned it.
[Unit]
Description=Restart Sidetone when it stops answering

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'systemctl --user is-active --quiet sidetone.service && systemctl --user restart sidetone.service || true'
